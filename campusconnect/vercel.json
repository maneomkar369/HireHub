{
  "version": 2,
  "builds": [
    {
      "src": "HireHub/wsgi.py",
      "use": "@vercel/python",
      "config": { 
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/media/(.*)",
      "dest": "/media/$1"
    },
    {
      "src": "/(.*)",
      "dest": "HireHub/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "HireHub.settings"
  }
}
